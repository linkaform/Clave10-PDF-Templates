<blockTableStyle id="general">
</blockTableStyle>

<blockTableStyle id="first_table">
    <blockValign value="MIDDLE" start="0,0" stop="-1,-1"/>
    <blockSpan start="0,0" stop="0,-1"/>
</blockTableStyle>

<blockTableStyle id="fifth_table">
    <blockValign value="MIDDLE" start="0,0" stop="-1,-1"/>
    <blockSpan start="-1,0" stop="-1,-2"/>
</blockTableStyle>

<blockTableStyle id="linea_divisoria">
    <lineStyle kind="LINEBELOW" colorName="#BDBDBD" thickness="0.5" dash="2,2" start="0,0" stop="-1,-1"/>
</blockTableStyle>

<blockTableStyle id="rounded_image_cell">
</blockTableStyle>

